{
  "manifest_version": 3,
  "name": "SelfGuide Local Browser Bridge",
  "version": "0.4.0",
  "description": "Connect one selected ChatGPT project tab to Codex on your own server through an SSH tunnel.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
